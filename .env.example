# =======================================================
# Zella Hostel Management System - Environment Configuration
# =======================================================

# Production Security Note:
# All default credentials are for local development/testing ONLY.
# You MUST change SECRET_KEY, DB credentials, and default logins before deploying to production.

# Application Settings
PROJECT_NAME="Zella Hostel Management System"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL Primary)
POSTGRES_USER=hostel_admin
POSTGRES_PASSWORD=hostel_secure_password_2026
POSTGRES_DB=hostel_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# SQLite Fallback (used automatically if PostgreSQL service is offline during local test/dev)
SQLITE_FALLBACK_URL=sqlite:///./hostel.db

# JWT Security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_char_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80"

# Initial Seed User Credentials (MUST be changed on first login in production)
ADMIN_EMAIL=admin@zellahostel.com
ADMIN_PASSWORD=Admin@12345
STAFF_EMAIL=staff@zellahostel.com
STAFF_PASSWORD=Staff@12345

# Frontend Port
FRONTEND_PORT=5173
BACKEND_PORT=8000
